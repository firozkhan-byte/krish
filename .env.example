# Copy to .env for local testing (vercel dev), or set these in your Vercel project's Environment Variables.
# SMTP_USER: the Gmail address you're sending from
# SMTP_PASS: a Gmail App Password (not your normal password) — see README instructions
# TO_EMAIL: address that receives quote requests (defaults to SMTP_USER if unset)
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
TO_EMAIL=Info@kirishnxindia.com
